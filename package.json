{
  "name": "appmuscu-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/coach-server",
    "build": "npm run build --workspace=apps/web",
    "server:start": "npm run start --workspace=apps/coach-server",
    "db:push": "npm run db:push --workspace=apps/coach-server"
  }
}
